# ==============================================================================
# ArbitragePro NextGen - Environment Configuration Template
# Renombra este archivo a .env y completa las credenciales reales para operar en vivo
# ==============================================================================

# 1. Configuración de Red
PORT=8080
HOST=127.0.0.1

# 2. Conector a The Odds API (Mercados Reales en Vivo)
# Obtén tu API Key gratuita o de pago en: https://the-odds-api.com/
ODDS_API_KEY=tu_api_key_de_the_odds_api_aqui

# 3. Notificaciones Push a Telegram (Alertas de Surebets con ROI >= 3%)
# 1) Habla con @BotFather en Telegram para crear un bot y obtener el token.
# 2) Obtén tu Chat ID o el ID de tu canal con @userinfobot o mediante la API de Telegram.
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_telegram_chat_id_aqui

# 4. Modo de Operación
# SIMULATION_MODE=True permite operar con el simulador estocástico sin gastar cuota de API
SIMULATION_MODE=True
